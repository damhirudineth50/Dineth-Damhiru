      "source": [
        "import pandas as pd\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "\n",
        "# Read the file as an HTML table (because the CBSL .xls file is actually in HTML format)\n",
        "tables = pd.read_html('Data.xls')\n",
        "df = tables[1] # The actual data is in the second table\n",
        "\n",
        "# Remove unnecessary columns to make the dataset clean\n",
        "cols_to_drop = [c for c in ['Unnamed: 0', 'Unit', 'Scale'] if c in df.columns]\n",
        "df = df.drop(columns=cols_to_drop)\n",
        "\n",
        "# Remove rows that do not have an 'Item Name' or contain category headers\n",
        "df = df.dropna(subset=['Item Name'])\n",
        "df = df[df['Item Name'] != 'Share Market Data-Overall Data']\n",
        "\n",
        "# Set the 'Item Name' as the index and transpose (swap rows and columns)\n",
        "# so that Dates become rows and Features become columns\n",
        "df.set_index('Item Name', inplace=True)\n",
        "df_t = df.T\n",
        "\n",
        "# Convert the row index into proper Date format\n",
        "df_t.index = pd.to_datetime(df_t.index, errors='coerce')\n",
        "df_t = df_t.dropna(how='all') # Drop any rows where the date is missing\n",
        "\n",
        "# Convert all values to numbers (floats) for calculations\n",
        "df_t = df_t.apply(pd.to_numeric)\n",
        "\n",
        "# Display the first 5 rows to check the data\n",
        "df_t.head()"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "# 1. Rename columns to simpler names for easier use\n",
        "df_t = df_t.rename(columns={\n",
        "    'EQUITY- All share price index': 'ASPI',\n",
        "    'EQUITY-S&P SL20 Index': 'S&P_SL20',\n",
        "    'EQUITY- Daily Turnover': 'Turnover',\n",
        "    'EQUITY- Volume of Turnover (No.)': 'Volume',\n",
        "    'EQUITY- No. of Transactions (Trades)': 'Trades',\n",
        "    'EQUITY-Market Capitalization': 'Market_Cap',\n",
        "    'EQUITY- Market Price Earnings Ratio': 'PE_Ratio'\n",
        "})\n",
        "\n",
        "# 2. Check for missing values (empty spaces) in each column\n",
        "print(\"Missing values before cleaning:\")\n",
        "print(df_t.isnull().sum())\n",
        "\n",
        "# 3. Fill missing values using Forward Fill (uses the previous day's value)\n",
        "df_t = df_t.fillna(method='ffill')\n",
        "\n",
        "# Verify that missing values are filled\n",
        "print(\"\\nMissing values after cleaning:\")\n",
        "print(df_t.isnull().sum())\n",
        "\n",
        "# 4. Get a basic statistical summary of the dataset (Mean, Min, Max, etc.)\n",
        "print(\"\\nStatistical Summary of the dataset:\")\n",
        "display(df_t.describe())"
      ],
