        "import gradio as gr\n",
        "import numpy as np\n",
        "\n",
        "# Function to predict the next day's ASPI\n",
        "def predict_next_day_aspi(aspi, turnover, volume, trades, market_cap, pe_ratio):\n",
        "    input_features = np.array([[aspi, turnover, volume, trades, market_cap, pe_ratio]])\n",
        "    prediction = lr_model.predict(input_features)\n",
        "    return f\"{round(prediction[0], 2)}\"\n",
        "\n",
        "# Modern and attractive Custom CSS (Dark mode with stylish orange/green gradients)\n",
        "custom_css = \"\"\"\n",
        "body { background-color: #121212; font-family: 'Inter', sans-serif; }\n",
        ".gradio-container { background: #18181b; border: 1px solid #27272a; border-radius: 16px; padding: 20px; box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.5); }\n",
        "h1 { color: #f43f5e; text-align: center; font-weight: 800; font-size: 2.4em; margin-bottom: 5px; }\n",
        "p { color: #a1a1aa; text-align: center; font-size: 1.1em; }\n",
        ".button-primary { background: linear-gradient(135deg, #f97316 0%, #ea580c 100%) !important; border: none !important; color: white !important; font-weight: bold !important; font-size: 1.1em !important; border-radius: 8px !important; transition: 0.3s; }\n",
        ".button-primary:hover { opacity: 0.9; transform: translateY(-2px); }\n",
        ".button-secondary { background: #27272a !important; color: #f4f4f5 !important; border: none !important; border-radius: 8px !important; }\n",
        "\"\"\"\n",
        "\n",
        "# Create the interactive Gradio Web Interface\n",
        "with gr.Blocks(css=custom_css, theme=gr.themes.Base()) as demo:\n",
        "    gr.Markdown(\"# 🚀 CSE Stock Market AI Predictor\")\n",
        "    gr.Markdown(\"An advanced machine learning dashboard to forecast the next day's All Share Price Index (ASPI).\")\n",
        "\n",
        "    with gr.Row():\n",
        "        with gr.Column(scale=1):\n",
        "            gr.Markdown(\"### 📊 Enter Market Indicators\")\n",
        "            in_aspi = gr.Number(label=\"Today's ASPI\", value=21269.67)\n",
        "            in_turnover = gr.Number(label=\"Daily Turnover (LKR mn)\", value=1750.50)\n",
        "            in_volume = gr.Number(label=\"Volume of Turnover (No.)\", value=110500000)\n",
        "            in_trades = gr.Number(label=\"No. of Transactions (Trades)\", value=15200)\n",
        "            in_mcap = gr.Number(label=\"Market Capitalization (LKR bn)\", value=8460)\n",
        "            in_pe = gr.Number(label=\"Market Price Earnings Ratio (PE)\", value=12.4)\n",
        "\n",
        "            with gr.Row():\n",
        "                clear_btn = gr.Button(\"Clear\", variant=\"secondary\", elem_classes=\"button-secondary\")\n",
        "                submit_btn = gr.Button(\"Calculate Prediction\", variant=\"primary\", elem_classes=\"button-primary\")\n",
        "\n",
        "        with gr.Column(scale=1):\n",
        "            gr.Markdown(\"### 🎯 Model Output\")\n",
        "            out_prediction = gr.Textbox(label=\"Predicted Next Day ASPI Value\", lines=3, interactive=False)\n",
        "            gr.Markdown(\"\"\"\n",
        "            ---\n",
        "            ### 💡 Instructions:\n",
        "            1. Input the required financial parameters on the left.\n",
        "            2. Click **Calculate Prediction** to run the Linear Regression model.\n",
        "            3. Use the resulting value for your project demonstration.\n",
        "            \"\"\")\n",
        "\n",
        "    # Button click binding\n",
        "    submit_btn.click(\n",
        "        fn=predict_next_day_aspi,\n",
        "        inputs=[in_aspi, in_turnover, in_volume, in_trades, in_mcap, in_pe],\n",
        "        outputs=out_prediction\n",
        "    )\n",
        "\n",
        "    clear_btn.click(\n",
        "        fn=lambda: (21269.67, 1750.50, 110500000, 15200, 8460, 12.4, \"\"),\n",
        "        inputs=[],\n",
        "        outputs=[in_aspi, in_turnover, in_volume, in_trades, in_mcap, in_pe, out_prediction]\n",
        "    )\n",
        "\n",
        "# Launch the dashboard\n",
        "demo.launch()"
